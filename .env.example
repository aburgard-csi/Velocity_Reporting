# Copy to .env and set for this machine. Not committed.
#
# RPE_DATA_ROOT is the pipeline tree holding Inputs/, Outputs/ and Build Artifacts/.
# It differs per machine and must never be hardcoded in the build code — see
# build/rpe_env.py.

# --- Mac (Google Drive for Desktop) ---
RPE_DATA_ROOT=/Users/<you>/Library/CloudStorage/GoogleDrive-<account>/My Drive/Work/RPE Pipeline

# --- CSI / Cowork machine (Windows, plain local drive) ---
# Confirmed by Aaron 2026-08-29. Moved off OneDrive 2026-07-17 to stop sync
# corruption. Note these mounts allow creating and copying files but NOT
# deleting: rm returns "Operation not permitted".
# RPE_DATA_ROOT=C:\Data Pipelines\RPE Pipeline

# --- Optional ---
# Reporting period for a build, YYYY.MM. Normally taken from the output
# filename's <yyyy.mm> tag, then from the Executive Summit month in
# build/assets/summit_slide.pptx. Set this to override both.
# RPE_PERIOD=2026.08
