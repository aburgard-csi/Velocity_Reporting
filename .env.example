# Copy to .env and set for this machine. Not committed.
#
# RPE_DATA_ROOT is the pipeline tree holding Inputs/, Outputs/ and Build Artifacts/.
# It differs per machine and must never be hardcoded in the build code — see
# build/rpe_env.py.

# --- Mac (Google Drive for Desktop) ---
RPE_DATA_ROOT=/Users/<you>/Library/CloudStorage/GoogleDrive-<account>/My Drive/Work/RPE Pipeline

# --- Windows / CSI / Cowork machine (Google Drive for Desktop) ---
# Aaron, 2026-09-01. The same Drive folder the Mac path above resolves to, under
# a different mount point — both machines read ONE tree.
# Replaces C:\Data Pipelines\RPE Pipeline (the plain local drive used from
# 2026-07-17 to 2026-09-01). That path is stale; do not set it.
# The old local mount allowed creating and copying but NOT deleting; whether the
# Drive mount does is untested — confirm before a build needs to replace a file.
# RPE_DATA_ROOT=G:\My Drive\Work\RPE Pipeline

# --- Optional ---
# Reporting period for a build, YYYY.MM. Normally taken from the output
# filename's <yyyy.mm> tag, then from the Executive Summit month in
# build/assets/summit_slide.pptx. Set this to override both.
# RPE_PERIOD=2026.08
