# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------- machine-local config
# RPE_DATA_ROOT and friends differ per machine. Never commit.
.env
.env.*
!.env.example

# ---------------------------------------------------------------- client data
# Data lives in Google Drive, not here. Nothing client-identifiable
# belongs in this repo.
#
# build/{ics,mrpc}_pipeline/data/ were DELETED 2026-08-29: they held copies of
# the VIP sheets that drifted against Inputs/VIP Data/ and shipped month-old
# figures. The ignore lines stay so a stray copy cannot be committed by accident.
build/ics_pipeline/data/
build/mrpc_pipeline/data/
build/ars_pipeline/data/
*.xlsx
*.xlsm
*.csv
*.tsv
*.zip
# NB: this also excludes tests/fixtures/synthetic_odd.csv, which is invented data
# and would be safe to commit. It is regenerated on first test run instead
# (tests/conftest.py) — a blanket "no client data" rule is worth more than one
# convenient exception.

# build evidence — sidecars and phase files. The repo-local copy is only the
# fallback used when RPE_DATA_ROOT is unset; normally these live under
# RPE_DATA_ROOT/Build Artifacts/.
build_artifacts/

# metrics_gen intermediates (metrics.json, base.json, lift.json, oddd_metrics.json,
# and MG_DUMP pickles) are per-client outputs, not source.
*.pkl
metrics*.json
base*.json
lift*.json
oddd*.json

# ---------------------------------------------------------------- build outputs
# Decks are outputs and belong in Drive at Work/RPE Pipeline/Outputs/.
# Templates are source and are the deliberate exception below.
*.pptx
!build/**/templates/*.pptx
!templates/*.pptx
!build/**/templates/*.potx
!templates/*.potx
*.pdf
charts_out/
assets_tmp/
ars_assets_*/
oddcsv_*/

# ---------------------------------------------------------------- OS noise
.DS_Store
Thumbs.db
desktop.ini
build/ars_pipeline/charts/
